{
  "name": "cannabis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cannabis: efficient community claims with zero-knowledge eligibility privacy and founder vesting.",
  "engines": {
    "node": ">=22.23.3"
  },
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "dev": "node scripts/dev.mjs",
    "worker:console": "node operator/server.mjs",
    "build:operator": "node scripts/build-market-wallet.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "verify:claim": "node scripts/claim.mjs",
    "verify:status": "node scripts/status.mjs",
    "prepare:claim": "node scripts/prepare-claim.mjs",
    "prepare:claim-threshold": "node scripts/prepare-claim-threshold.mjs",
    "compute:plan": "node scripts/compute-plan.mjs",
    "compute:escrow": "node scripts/compute-escrow.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:work-service": "node scripts/build-work-service.mjs",
    "prepare:launch": "node scripts/prepare-launch.mjs",
    "prepare:network-release": "node scripts/prepare-network-release.mjs",
    "quote:launch": "node scripts/quote-launch.mjs",
    "participant": "node scripts/participant.mjs",
    "exercise:local": "node scripts/exercise-activity.mjs",
    "exercise:microjobs": "node scripts/exercise-microjobs.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs"
  },
  "license": "MIT",
  "overrides": {
    "tmp": "0.2.7",
    "ethers": "$ethers",
    "snarkjs": "0.7.6",
    "underscore": "1.13.8"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@semaphore-protocol/contracts": "4.14.5",
    "@semaphore-protocol/group": "4.14.5",
    "@semaphore-protocol/identity": "4.14.5",
    "@semaphore-protocol/proof": "4.14.5",
    "age-encryption": "0.3.1",
    "ethers": "6.17.0",
    "hardhat": "3.20.0",
    "jose": "6.2.12",
    "solc": "0.8.37"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "markdown-it": "15.0.3"
  }
}
